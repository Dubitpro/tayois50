rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow updates for likes, views, etc.
      allow update: if request.auth != null; 
      allow delete: if request.auth != null && request.auth.uid == resource.data.anonymousId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
